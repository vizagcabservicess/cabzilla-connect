# Database Configuration
DB_HOST=localhost
DB_NAME=u644605165_vth_db
DB_USER=u644605165_vth_usr
DB_PASS=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here

# Optional: comma-separated Google OAuth client IDs (Web + Android + iOS) for id_token audience checks on social-login.php
# GOOGLE_OAUTH_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com

# Pooling Database Configuration
POOLING_DB_HOST=localhost
POOLING_DB_NAME=u644605165_db_be
POOLING_DB_USER=u644605165_usr_be
POOLING_DB_PASS=your_secure_pooling_password_here

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Application Configuration
APP_DEBUG=false
APP_ENV=production

# After driver fuel receipt/pump upload, send Expo push to admin + super_admin (requires push_tokens). Set 0 to disable.
# FUEL_REFILL_ADMIN_PUSH=1

# Web Push (browser / admin desktop) — run: cd php-templates && composer install
# Generate keys: npx --yes web-push generate-vapid-keys  (or openssl per web-push docs)
# WEB_PUSH_VAPID_SUBJECT=mailto:you@yourdomain.com
# WEB_PUSH_VAPID_PUBLIC_KEY=BF8x...
# WEB_PUSH_VAPID_PRIVATE_KEY=...
# Apply sql/web_push_subscriptions.sql — deploy api/public/web-push-vapid-public.php + api/auth/register-web-push.php

# Google Cloud (for Vision OCR and optional GCS storage)
GCP_PROJECT_ID=vizagtaxihub
GCP_SERVICE_ACCOUNT_JSON=config/gcp-service-account.json
GCS_BUCKET=vizag-taxi-hub-storage

# Google Gemini — fuel-vision-unified.php, upload-fuel-odometer pump (single unified decode + fuelUnifiedVision in JSON), fuel-pump-vision.php.
# Server only. Create a new key in Google AI Studio after revoking any key that was pasted into source or a chat.
GEMINI_API_KEY=
# OpenAI chatbot.php. Server only. Revoke any key that was written into the PHP file.
OPENAI_API_KEY=
# Server-side Places proxy (public/api/places-autocomplete.php). Restrict by server IP in Google Cloud. Do not reuse the website browser key.
GOOGLE_MAPS_API_KEY=
# Optional model override (default gemini-2.5-flash-lite)
# GEMINI_FUEL_OCR_MODEL=gemini-2.5-flash-lite
# v1beta cachedContents for systemInstruction (1h TTL, meta under sys temp). Set 0 to always send inline system prompt.
# GEMINI_FUEL_OCR_SYSTEM_CACHE=1
# Images are resized to JPEG before generateContent. Defaults: max width 2048, quality 88 (mobile pump stencil matches). Max 2560.
# GEMINI_FUEL_OCR_MAX_WIDTH=2048
# GEMINI_FUEL_OCR_JPEG_QUALITY=88
# Max output tokens (default 1024 extract, 2048 unified) — raise if you see parse_json_failed from truncated JSON.
# GEMINI_FUEL_OCR_MAX_OUTPUT_TOKENS=1024
# GEMINI_FUEL_OCR_UNIFIED_MAX_OUTPUT_TOKENS=2048
# Unified decode uses a short system prompt per phase (receipt / odometer / pump) so TEXT input tokens stay low; CNG rules are appended only for cng fuel kind.
# Pump: try to fix 47.xx L misread as 4.1xx L (Tokheim) after Gemini. Set 0 to disable. May rarely affect very small real fills in the same numeric band.
# FUEL_PUMP_RECOVER_DECADE_LITRE=1
# Pump: when the driver captured a receipt first, use receipt total (receiptTotalOcr on pump upload) to correct tallies if pump shows a hundreds-level total (~₹455) but receipt shows thousands (~₹4563). Set 0 to disable.
# FUEL_PUMP_RECEIPT_RECONCILE_LITRES=1
# CNG (kg): reject pump readings above this quantity so a coherent 10× OCR error (e.g. 4.117→41.11, ₹379→₹3790) cannot auto-approve. Raise for heavy commercial fills (default 22).
# FUEL_PUMP_CNG_MAX_PLAUSIBLE_KG=22
# Petrol: when ₹/L looks grossly wrong (>97.3 or <94.55), search nearby L + ₹/L vs anchor (does not run for normal 95–97 — avoids snapping 96.19→96.35). Set 0 to disable.
# FUEL_PUMP_REFINE_PETROL_VOL_RATE=1
# FUEL_PUMP_PETROL_RATE_ANCHOR=96.35
# FUEL_PUMP_REFINE_RATE_MIN=94.6
# FUEL_PUMP_REFINE_RATE_MAX=98.2
# FUEL_PUMP_REFINE_AMOUNT_TOL_INR=0.35
# Pump: recover IOCL field confusion (₹/L in amount slot; litres in fuel_amount + garbage volume; bogus high "rate"). Set 0 to disable.
# FUEL_PUMP_RECOVER_FIELD_CONFUSION=1
# Pump: reject coherent readings if sale total (₹) is below this while litres exceed the minimum (glare-shortened Amount row). Defaults: 600 / 10 L.
# FUEL_PUMP_GLARE_SHORT_TOTAL_MAX_INR=600
# FUEL_PUMP_GLARE_MIN_VOLUME_L=10
# Pump: mandatory V×R vs amount — max |Δ| in ₹ (default 0.10). Compares to round(V×R,2) or nearest whole rupee (LCD).
# FUEL_PUMP_MATH_MAX_DIFF_INR=0.10
# Pump: if Amount differs from round(V×R,2) by more than MATH_MAX_DIFF but ≤ snap max ₹ and ≤ snap rel %, set Amount = round(V×R,2) (fixes glare digit on total row). Set 0 to disable.
# FUEL_PUMP_SNAP_AMOUNT_FROM_VOLUME_RATE=1
# FUEL_PUMP_AMOUNT_VR_SNAP_MAX_INR=15
# FUEL_PUMP_AMOUNT_VR_SNAP_MAX_REL_PCT=0.35
# Set to 1 to write Gemini request/response excerpts and timings to PHP error_log (no API key logged).
# GEMINI_FUEL_OCR_LOG_RAW=1
# Set to 1 to log one JSON line per generateContent with usage_metadata (tokens), latency_ms, cache flag (same line format as LOG_RAW usage).
# GEMINI_FUEL_OCR_LOG_USAGE=1

# Guest cab search alert — api/track-search.php (optional; falls back to WHATSAPP_ADMIN_PHONE from your WhatsApp block in .env)
# OWNER_WHATSAPP_NUMBER=919966363662










