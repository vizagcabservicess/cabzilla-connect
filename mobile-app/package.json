{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "proxy": "node scripts/dev-proxy.js",
    "web:dev": "concurrently -k -n proxy,web \"npm run proxy\" \"cross-env EXPO_PUBLIC_API_BASE_URL=http://localhost:9090 npm run web\"",
    "start": "expo start --port 8080",
    "android": "expo start --android --port 8080",
    "ios": "expo start --ios --port 8080",
    "web": "expo start --web --port 8080",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "build:android": "npx eas build --platform android --profile production",
    "build:android:preview": "npx eas build --platform android --profile preview",
    "build:ios": "npx eas build --platform ios --profile production",
    "build:all": "npx eas build --platform all --profile production",
    "submit:android": "npx eas submit --platform android --latest",
    "submit:ios": "npx eas submit --platform ios --latest"
  },
  "dependencies": {
    "@codearcade/expo-razorpay": "^1.5.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.17.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.4",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.11",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-text-extractor": "^2.0.0",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/google.maps": "^3.58.1",
    "@types/react": "~19.1.10",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "http-proxy-middleware": "^3.0.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
