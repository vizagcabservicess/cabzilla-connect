{
  "expo": {
    "name": "Vizag Taxi Hub",
    "slug": "vizag-taxi-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vizagtaxihub.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vizag Taxi Hub uses your location for live trip tracking.",
        "NSCameraUsageDescription": "Vizag Taxi Hub uses the camera to photograph odometer readings and fuel receipts.",
        "NSPhotoLibraryUsageDescription": "Vizag Taxi Hub may access photos you select for receipts."
      }
    },
    "android": {
      "package": "com.vizagtaxihub.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vizagtaxihub",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Vizag Taxi Hub may access photos you select for fuel receipts.",
          "cameraPermission": "Vizag Taxi Hub uses the camera for odometer readings and fuel receipt photos."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withOptionalAndroidHardware.js"
    ],
    "extra": {
      "eas": {
        "projectId": "9057ad8a-c71d-4e2b-92b2-0b7bab1f97ee"
      }
    }
  }
}
