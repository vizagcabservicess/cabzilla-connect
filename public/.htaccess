# TEMPO TRAVELLER PAGES - Now handled by React components
# All tempo traveller pages now have proper React components with content
# No server-side redirects needed - React router handles all routing

# LOCATION-SPECIFIC TEMPO TRAVELLER ROUTES - Redirect to main tempo traveller page
RewriteRule ^tempo-traveller-madhurawada$ /vehicle/tempo-traveller [R=301,L]
RewriteRule ^tempo-traveller-dwaraka-nagar$ /vehicle/tempo-traveller [R=301,L]
