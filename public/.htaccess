# Enable URL rewriting
RewriteEngine On

# Set the base directory
RewriteBase /


# CRITICAL: Force non-www redirect to prevent duplicate content
# Redirect www to non-www (301 permanent redirect)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Force HTTPS redirect (optional - only if you want to force HTTPS)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|skypeuripreview|slackbot|discordbot|ahrefsbot|semrushbot|mozbot|rogerbot|dotbot|ia_archiver|archive\.org_bot|ia_archiver-web\.archive\.org|screamingfrog|sitebulb|deepcrawl|botify|oncrawl|seolyzer|seoptimer|seositecheckup|seochecker|seoanalyzer|seotools|seomoz|semrush|ahrefs|majestic|sistrix|searchmetrics|conductor|brightedge|seoclarity|seoprofiler|seopanel|bot|crawler|spider|scraper|indexer|fetcher|Mozilla/5\.0.*compatible.*Googlebot) [NC]
RewriteCond %{REQUEST_URI} !^/(api|admin|uploads|assets|css|js|images|fonts|favicon\.png|robots\.txt|sitemap\.xml|seo-handler\.php)$
RewriteCond %{REQUEST_URI} !^/(api|admin|uploads|assets|css|js|images|fonts|favicon\.png|robots\.txt|sitemap\.xml|seo-handler\.php)/
RewriteCond %{REQUEST_URI} !^/(tempo-traveller-rental-vizag|17-seater-tempo-traveller-vizag|12-seater-tempo-traveller-vizag|group-travel-tempo-traveller-vizag|corporate-tempo-traveller-vizag|wedding-tempo-traveller-vizag|pilgrimage-tempo-traveller-vizag|18-seater-tempo-traveller-vizag|mini-bus-travels-vizag)$
RewriteRule ^(.*)$ /seo-handler.php?url=$1 [L,QSA]

# SEO Handler - Only when explicitly requested with ?seo=1
RewriteCond %{QUERY_STRING} seo=1
RewriteRule ^(.*)$ /seo-handler.php?url=$1 [L,QSA]

# Handle OPTIONS requests for CORS preflight - immediately return 200
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=200,L]

# Set secure CORS headers for all responses - SECURITY: Restrict to trusted domains only
<IfModule mod_headers.c>
    # SECURITY: Only allow trusted domains + localhost for development (Expo web, mobile app dev)
    SetEnvIf Origin "^https://vizagtaxihub\.com$" ALLOWED_ORIGIN=$0
    SetEnvIf Origin "^https://www\.vizagtaxihub\.com$" ALLOWED_ORIGIN=$0
    SetEnvIf Origin "^http://localhost(:\d+)?$" ALLOWED_ORIGIN=$0
    SetEnvIf Origin "^http://127\.0\.0\.1(:\d+)?$" ALLOWED_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{ALLOWED_ORIGIN}e" env=ALLOWED_ORIGIN
    Header always set Access-Control-Allow-Origin "https://vizagtaxihub.com" env=!ALLOWED_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-Force-Refresh, X-Admin-Mode, X-Debug, X-Database-First"
    Header always set Access-Control-Max-Age "86400"
    Header always set Access-Control-Expose-Headers "Content-Type, Authorization"
    Header always set X-Content-Type-Options "nosniff"
       
    # Cache Control Headers for Static Assets
    # No cache for HTML files
    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
    
    # Long-term caching for hashed assets (Vite: name-hash.ext, hash is alphanumeric)
    <FilesMatch ".*-[a-zA-Z0-9]{8,}\.(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # No cache for non-hashed JS/CSS only
    <FilesMatch "^(?!.*-[a-zA-Z0-9]{8,}\.(js|css)$).*\.(js|css)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
    
    # Force no cache for index.html
    <Files "index.html">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Files>
    
    # Default cache control for other files
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</IfModule>

# CRITICAL: Enable direct access to PHP files in the admin directory
<FilesMatch "\.(php)$">
    # Ensure proper PHP handling
    SetHandler application/x-httpd-php
    # For API responses
    Header always set Content-Type "application/json" env=!no_content_type
    # No caching
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# SPECIAL RULE: SEO Handler should serve HTML, not JSON
<Files "seo-handler.php">
    # Set environment variable to identify SEO handler
    SetEnv is_seo_handler 1
    SetEnv no_content_type 1
    # Explicitly set HTML content type for SEO handler
    Header always set Content-Type "text/html; charset=utf-8"
    SetHandler application/x-httpd-php
    # No caching for SEO handler
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# Fix content type for OG image
<Files "og-image.png">
    Header set Content-Type "image/png"
    Header set Cache-Control "public, max-age=31536000"
</Files>

# Direct access to all PHP files - CRITICAL NEW RULE
<Files ~ "\.php$">
    Order Allow,Deny
    Allow from all
    SetHandler application/x-httpd-php
</Files>

# SPECIAL RULES FOR PDF FILES - Critical for proper PDF downloads
<FilesMatch "\.(pdf)$">
    ForceType application/pdf
    Header set Content-Type application/pdf
    Header set Content-Disposition attachment
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "must-revalidate"
</FilesMatch>

# SPECIAL RULE FOR INVOICE DOWNLOAD - Override Content-Type for this file only
<FilesMatch "download-invoice\.php$">
    # Don't set Content-Type here, let the script handle it
    SetEnv no_content_type 1
    Header unset Content-Type env=no_content_type
    SetHandler application/x-httpd-php
    # SECURITY: Restrict CORS to trusted domains only
    SetEnvIf Origin "^https://vizagtaxihub\.com$" ALLOWED_ORIGIN=$0
    SetEnvIf Origin "^https://www\.vizagtaxihub\.com$" ALLOWED_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{ALLOWED_ORIGIN}e" env=ALLOWED_ORIGIN
    Header always set Access-Control-Allow-Origin "https://vizagtaxihub.com" env=!ALLOWED_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</FilesMatch>

# PDF Download Fix - CRITICAL - Address the PDF download issue
<Files "download-invoice.php">
    # Allow the script to set its own content type
    SetEnvIf Request_URI "download-invoice" no_content_type=1
    Header always unset Content-Type env=no_content_type
    Header always set X-Content-Type-Options "nosniff" env=no_content_type
</Files>

# CRITICAL BOOKING API ENDPOINTS - HIGH PRIORITY (Ensure these come first)
RewriteRule ^api/admin/assign-driver/?$ /api/admin/assign-driver.php [L,NC,QSA]
RewriteRule ^api/admin/cancel-booking/?$ /api/admin/cancel-booking.php [L,NC,QSA]
RewriteRule ^api/admin/update-booking/?$ /api/admin/update-booking.php [L,NC,QSA]
RewriteRule ^api/admin/generate-invoice/?$ /api/admin/generate-invoice.php [L,NC,QSA]
RewriteRule ^api/admin/download-invoice/?$ /api/admin/download-invoice.php [L,NC,QSA]
RewriteRule ^api/download-invoice/?$ /api/download-invoice.php [L,NC,QSA]

# Special handling for PDF files - direct linking
<FilesMatch "\.pdf$">
    ForceType application/pdf
    Header always set Content-Type application/pdf
    Header always set Content-Disposition attachment
</FilesMatch>

# CRITICAL SECTION: ADMIN BOOKING ENDPOINTS - MUST BE FIRST!
# Explicit booking endpoint mappings - these MUST be at the top and have high priority
RewriteRule ^api/admin/booking/?$ /api/admin/booking.php [L,NC,QSA]
RewriteRule ^api/admin/booking/([0-9]+)/?$ /api/admin/booking.php?id=$1 [L,NC,QSA]
RewriteRule ^api/admin/bookings/?$ /api/admin/booking.php [L,NC,QSA]
RewriteRule ^api/admin/bookings/([0-9]+)/?$ /api/admin/booking.php?id=$1 [L,NC,QSA]
RewriteRule ^api/admin/test-booking-api/?$ /api/admin/test-booking-api.php [L,NC,QSA]

# CRITICAL: Email verification endpoint - MUST BE HIGH PRIORITY (before other API routes)
RewriteRule ^api/auth/verify-email/?$ /api/auth/verify-email.php [L,NC,QSA]

# HIGHEST PRIORITY: Ensure proper access to get-drivers.php
RewriteRule ^api/admin/get-drivers\.php$ /api/admin/get-drivers.php [L,NC,QSA]
RewriteRule ^api/admin/get-drivers$ /api/admin/get-drivers.php [L,NC,QSA]

# Add direct access to the book endpoint - HIGHEST PRIORITY
RewriteRule ^api/book/?$ /api/book.php [L,NC,QSA]
RewriteRule ^create-booking/?$ /api/book.php [L,NC,QSA]
RewriteRule ^api/create-booking/?$ /api/book.php [L,NC,QSA]

# Add direct access to the test endpoint
RewriteRule ^test-booking-api/?$ /api/admin/test-booking-api.php [L,NC,QSA]

# User bookings endpoints
RewriteRule ^api/user/bookings/?$ /api/user/bookings.php [L,NC,QSA]
RewriteRule ^api/bookings/?$ /api/bookings.php [L,NC,QSA]

# Admin Group Tour Management
RewriteRule ^api/admin/group-tour-management/?$ /api/admin/group-tour-management.php [L,NC,QSA]
RewriteRule ^api/admin/group-tour-bookings/?$ /api/admin/group-tour-bookings.php [L,NC,QSA]
