RewriteRule ^tempo-traveller-rushikonda$ /vehicle/tempo-traveller [R=301,L]

# Handle trailing slashes
RewriteRule ^(.+)/$ /$1 [R=301,L]

# CRITICAL: Don't apply rewriting to actual files or directories
# BUT: Allow API routes to be processed even if file doesn't exist (they'll be handled by PHP)
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d



# Send all other requests to index.html for React to handle
RewriteRule ^(.*)$ /index.html [L]

# Set PHP settings
<IfModule mod_php7.c>
    php_flag display_errors on
    php_value error_reporting E_ALL
    php_value memory_limit 256M
    php_value max_execution_time 30
    php_value output_buffering 4096
    php_value include_path ".:/public_html/vendor"
</IfModule>

# SECURITY: Block access to suspicious/randomly named directories
# Block the known malicious folder
RewriteRule ^hnfwdpvmyh(/.*)?$ - [F,L]

# Block access to suspicious directories (random character patterns that aren't whitelisted)
# Whitelist known legitimate directories first
RewriteCond %{REQUEST_URI} !^/(api|admin|uploads|assets|css|js|images|fonts|logs|vendor|cache|data|dist|public|src|node_modules|lovable-uploads) [NC]
# Block directories with 8+ consecutive random lowercase letters/numbers (potential backdoors)
RewriteCond %{REQUEST_URI} ^/[a-z0-9]{8,}(/.*)?$ [NC]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule .* - [F,L]

# Prevent direct access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini)$">
    Require all denied
</FilesMatch>

# SECURITY: Prevent PHP execution in unauthorized directories
# Only allow PHP execution in specific whitelisted directories
<DirectoryMatch "^/.*/(hnfwdpvmyh|tmp|temp|test|shell|cmd|wso|uploader|filemanager)">
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</DirectoryMatch>

# Force proper MIME type for PHP files to ensure they're executed correctly
AddType application/x-httpd-php .php
AddType application/pdf .pdf

# Disable output buffering for PDF files
<FilesMatch "\.(pdf)$">
    php_flag output_buffering Off
</FilesMatch>

# Handle PHP errors
ErrorDocument 500 "PDF Generation Error. Please check the error logs."

# SECURITY: Set secure CORS headers - Restrict to trusted domains only
Header set Access-Control-Allow-Origin "https://vizagtaxihub.com"
Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

# Map /api/pooling/search and /api/pooling/search.php to /api/pooling/search.php
RewriteRule ^api/pooling/search/?$ /api/pooling/search.php [L,QSA]
RewriteRule ^api/pooling/search.php$ /api/pooling/search.php [L,QSA]
